{
  "contract": "evaluchat-research-repository-layout",
  "supportedReaderVersion": "1.0",
  "compatibility": {
    "supportedVersionAccess": "read-write",
    "unsupportedMajorAccess": "read-only",
    "laterMinorAccess": "read-only",
    "rule": "Readers open unsupported major versions and later unsupported minor versions read-only."
  },
  "fixtures": {
    "v1.0": {
      "root": "v1.0",
      "layoutVersion": "1.0",
      "expectedAccess": "read-write"
    },
    "v1.1": {
      "root": "v1.1",
      "layoutVersion": "1.1",
      "expectedAccess": "read-only",
      "description": "Synthetic future-minor layout for a reader supporting only v1.0."
    }
  }
}
